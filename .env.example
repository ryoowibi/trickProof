# Trickproof — copy to .env and fill in. NEVER commit .env.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_EXPLORER_TX=https://testnet.nearblocks.io/txns/

# Accounts (create them yourself on testnet, see README → Quick start)
CONTRACT_ID=trickproof-xxx.testnet
OWNER_ID=owner-xxx.testnet
AGENT_ID=budi-xxx.testnet
MERCHANT_ID=toko-xxx.testnet
ATTACKER_ID=penyerang-xxx.testnet

# Keys used ONLY by `npm run setup`. Leave empty to read them from
# ~/.near-credentials/testnet/<account>.json (near-cli legacy keychain).
CONTRACT_PRIVATE_KEY=
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# Written by `npm run setup`: Budi's function-call key (only method: pay).
# This is the ONLY key the agent runtime loads.
AGENT_FCK_PRIVATE_KEY=

# Initial policy used by `npm run setup` (in NEAR)
MAX_PER_TX_NEAR=1
MAX_PER_DAY_NEAR=3
VAULT_FUND_NEAR=4
AGENT_GAS_ALLOWANCE_NEAR=1

# Budi's brain. Leave LLM_API_KEY empty to use the built-in "naive" brain
# (no LLM, equally gullible: decodes Morse and obeys it).
LLM_BASE_URL=https://cloud-api.near.ai/v1
LLM_MODEL=zai-org/GLM-5.1-FP8
LLM_API_KEY=

PORT=8787
